            "description": "Exécute une requête SQL en lecture seule. ⚠️ Requiert la permission api_query."
          }
        }
      ]
    },
    {
      "name": "Logistique",
      "item": [
        {
          "name": "Logistique - Catalogue (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/logistique?action=catalogue&tarif=STANDARD&last_change=2026-01-01 00:00:00",
              "host": ["{{base_url}}"],
              "path": ["logistique"],
              "query": [
                { "key": "action", "value": "catalogue", "description": "catalogue, attentes_receptions ou demandes_expeditions" },
                { "key": "tarif", "value": "STANDARD", "description": "Code tarif (requis pour catalogue)" },
                { "key": "last_change", "value": "2026-01-01 00:00:00", "description": "Date de dernière modification (requis pour catalogue)" }
              ]
            },
            "description": "Récupère le catalogue produits logistique. Permission requise : api_logistique"
          }
        },
        {
          "name": "Logistique - Attentes Réceptions (GET)",
          "request": {
            "method": "GET",
