{
  "info": {
    "name": "Kort Interiors - Backend Local (Complet)",
    "description": "Collection complète avec tous les bodies et paramètres pour les 30 endpoints Joolan. Votre serveur tourne sur http://localhost:6002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:6002/api/v1/joolan",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Export Tickets (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/export?Date=2026-06-02",
              "host": ["{{base_url}}"],
              "path": ["tickets", "export"],
              "query": [
                { "key": "Date", "value": "2026-06-02", "description": "Date au format AAAA-MM-JJ" }
              ]
            },
            "description": "Retourne les entêtes, lignes et règlements des tickets d'une date donnée."
          }
        },
        {
          "name": "Import Tickets (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tickets/import",
              "host": ["{{base_url}}"],
              "path": ["tickets", "import"],
              "query": [
                { "key": "Magasins_Stocks", "value": "", "description": "Ex: 'PARIS','OPERA' (optionnel)", "disabled": true }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "[\n  {\n    \"Magasin\": \"OPERA\",\n    \"Caisse\": 1,\n    \"Nature\": \"VENTE\",\n    \"Vendeur\": \"SERGE\",\n    \"Lignes\": [\n      {\n        \"Produit\": \"ANGELA\",\n        \"Couleur\": \"BLEU\",\n        \"Taille\": \"S\",\n        \"Designation\": \"Chemise Angela Coton\",\n        \"Quantite\": 1,\n        \"Prix_Vente\": 175,\n        \"Taux_TVA\": 0\n      }\n    ],\n    \"Reglements\": [\n      {\n        \"Montant\": 175,\n        \"ModeReg\": \"300\",\n        \"Libelle\": \"CARTE BANCAIRE\",\n        \"Reference\": \"transaction CB 1234\"\n      }\n    ]\n  }\n]"
            },
            "description": "Importe une liste de tickets (ventes, avoirs, acomptes, etc.)"
          }
        },
        {
          "name": "Annulation Ticket (POST)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/annulation?Entete=12345&Motif=Erreur de saisie",
              "host": ["{{base_url}}"],
              "path": ["tickets", "annulation"],
              "query": [
                { "key": "Entete", "value": "12345", "description": "Numéro d'entête du ticket à annuler" },
                { "key": "Motif", "value": "Erreur de saisie", "description": "Motif de l'annulation" }
              ]
            },
            "description": "Annule un ticket existant en indiquant son numéro et un motif."
          }
        },
        {
          "name": "Ticket PDF (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/pdf?Entete=12345&format=receipt",
              "host": ["{{base_url}}"],
              "path": ["tickets", "pdf"],
              "query": [
                { "key": "Entete", "value": "12345", "description": "Numéro d'entête du ticket" },
                { "key": "format", "value": "receipt", "description": "receipt ou A4" }
              ]
            },
            "description": "Retourne le ticket au format PDF encodé en base64."
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Recherche Clients (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/clients/recherche",
              "host": ["{{base_url}}"],
              "path": ["clients", "recherche"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"Search\": [\n    {\n      \"Field\": \"Email\",\n      \"Value\": \"client@example.com\"\n    }\n  ]\n}"
            },
            "description": "Recherche de clients par critères (Email, Nom, Mobile, etc.)"
          }
        },
        {
          "name": "Import Clients (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/clients/import",
              "host": ["{{base_url}}"],
              "path": ["clients", "import"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "[\n  {\n    \"Nom\": \"DUPONT\",\n    \"Prenom\": \"Jean\",\n    \"email\": \"jean.dupont@example.com\",\n    \"Mobile\": \"+33612345678\",\n    \"Ville\": \"PARIS\"\n  }\n]"
            },
            "description": "Import de fiches clients (création ou mise à jour). Permission requise : import_clients"
          }
        }
      ]
    },
    {
      "name": "Stocks & Catalogue",
      "item": [
        {
          "name": "Consulter Stock (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/stock?Produit=TSHIRT-001&Couleur=BLANC&Taille=M&Magasins=PARIS;LYON",
              "host": ["{{base_url}}"],
              "path": ["stock"],
              "query": [
                { "key": "Produit", "value": "TSHIRT-001", "description": "Code produit (obligatoire)" },
                { "key": "Couleur", "value": "BLANC", "description": "Code couleur (optionnel)" },
                { "key": "Taille", "value": "M", "description": "Code taille (optionnel)" },
                { "key": "Magasins", "value": "PARIS;LYON", "description": "Liste magasins séparés par point-virgule (optionnel)" }
              ]
            },
            "description": "Retourne les informations de stock pour un produit donné."
          }
        },
        {
          "name": "Image Stock - Non nuls (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/stock/image?Magasins=PARIS;LYON",
              "host": ["{{base_url}}"],
              "path": ["stock", "image"],
              "query": [
                { "key": "Magasins", "value": "PARIS;LYON", "description": "Liste magasins séparés par point-virgule (tous si vide)" }
              ]
            },
            "description": "Retourne les stocks non nuls uniquement. Permission requise : stock"
          }
        },
        {
          "name": "Image Full Stock - Tous (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/stock/image-full?Magasins=PARIS;LYON",
              "host": ["{{base_url}}"],
              "path": ["stock", "image-full"],
              "query": [
                { "key": "Magasins", "value": "PARIS;LYON", "description": "Liste magasins séparés par point-virgule (tous si vide)" }
              ]
            },
            "description": "Retourne l'image complète des stocks : tous les SKUs × tous les magasins, y compris les stocks à 0. Permission requise : stock"
          }
        },
        {
          "name": "Catalogue Web (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/catalogue-web?output-format=json&last-call=2026-01-01 00:00:00&Magasin=PARIS",
              "host": ["{{base_url}}"],
              "path": ["catalogue-web"],
              "query": [
                { "key": "output-format", "value": "json", "description": "tsv, csv ou json (obligatoire)" },
                { "key": "last-call", "value": "2026-01-01 00:00:00", "description": "Date de dernière synchro (optionnel)" },
                { "key": "Magasin", "value": "PARIS", "description": "Code magasin pour le tarif (optionnel)" },
                { "key": "Produit", "value": "TSHIRT-001", "description": "Filtrer sur un produit (optionnel)", "disabled": true }
              ]
            },
            "description": "Retourne le catalogue e-commerce (eCommerce=1). Permission requise : catalogue"
          }
        },
        {
          "name": "Vérifier EAN (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ean-existe?ean=3760123456789",
              "host": ["{{base_url}}"],
              "path": ["ean-existe"],
              "query": [
                { "key": "ean", "value": "3760123456789", "description": "Code EAN à vérifier (obligatoire)" }
              ]
            },
            "description": "Vérifie l'existence d'un code EAN. Retourne du texte brut : OK + détails, ou KO + EAN. ⚠️ Aucun contrôle de clé API côté Joolan."
          }
        }
      ]
    },
    {
      "name": "Produits",
      "item": [
        {
          "name": "Import Produits (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/produits/import",
              "host": ["{{base_url}}"],
              "path": ["produits", "import"],
              "query": [
                { "key": "reset_tarif", "value": "1", "description": "Supprime les tarifs existants avant réimport (optionnel)", "disabled": true }
              ]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "[\n  {\n    \"Produit\": \"TSHIRT-001\",\n    \"Designation\": \"T-shirt coton\",\n    \"Couleur\": \"BLANC\",\n    \"Taille\": \"M\",\n    \"EAN\": \"3760123456789\",\n    \"Rayon\": \"TEXTILE\",\n    \"Famille\": \"HAUTS\",\n    \"Marque\": \"MARQUE1\",\n    \"Prix_Achat\": 15,\n    \"Prix_Vente\": 49.9\n  }\n]"
            },
            "description": "Import de produits avec déclinaisons. Colonnes obligatoires : Produit, Couleur, Taille. Permission requise : import_produits"
          }
        },
        {
          "name": "Import Tarifs (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/produits/tarifs",
              "host": ["{{base_url}}"],
              "path": ["produits", "tarifs"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "[\n  {\n    \"Tarif\": \"STANDARD\",\n    \"Produit\": \"TSHIRT-001\",\n    \"Couleur\": \"BLANC\",\n    \"Taille\": \"M\",\n    \"Prix_Vente\": 49.9,\n    \"Remise_Vente\": 0\n  }\n]"
            },
            "description": "Import de prix de vente par tarif/produit. Une ligne avec Prix_Vente = -1 supprime le tarif. Permission requise : import_tarifs"
          }
        },
        {
          "name": "Import Produits Associés (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/produits/associes",
              "host": ["{{base_url}}"],
              "path": ["produits", "associes"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "[\n  {\n    \"Produit\": \"TSHIRT-001\",\n    \"Couleur\": \"BLANC\",\n    \"Produit_Associe\": \"JEAN-001\",\n    \"Couleur_Associee\": \"BLEU\"\n  }\n]"
            },
            "description": "Import d'associations entre produits (ventes croisées, suggestions). Permission requise : import_produits_associes"
          }
        }
      ]
    },
    {
      "name": "Mouvements",
