# ─── SERVER ────────────────────────────────────────────────
PORT=5000
API_VERSION=v1
BACKEND_URL=https://votre-domaine.com

# ─── DATABASE (PostgreSQL) ─────────────────────────────────
DB_NAME=kort-interior
DB_USER=postgres
DB_PASSWORD=VOTRE_MOT_DE_PASSE_DB
DB_HOST=localhost
DB_PORT=5432

# ─── SECURITY (CRITIQUE - changer en prod!) ───────────────
JWT_SECRET=remplacer_par_une_cle_tres_longue_et_aleatoire_min_64_caracteres

# ─── CORS (séparer plusieurs domaines par une virgule) ────
ALLOWED_ORIGINS=https://votre-domaine.com,https://admin.votre-domaine.com

# ─── JOOLAN (Oopos) ───────────────────────────────────────
OOPOS_DOMAIN=caisse.oopos.fr
OOPOS_ENSEIGNE=VOTRE_ENSEIGNE
OOPOS_API_KEY=VOTRE_CLE_API

# ─── EMAIL (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.votre-fournisseur.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASSWORD=VOTRE_MOT_DE_PASSE_SMTP

# ─── SMS (TunisieSMS) ─────────────────────────────────────
TUNISIESMS_API_KEY=VOTRE_CLE_API_SMS
TUNISIESMS_SENDER_ID=KORT

# ─── INSTAGRAM SCRAPING (optionnel) ──────────────────────
SCRAPECREATORS_API_KEY=